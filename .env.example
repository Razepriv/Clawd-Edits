# Copy to .env (never commit) and fill in your own keys.
# All required for a full end-to-end reel; optional ones are marked.

# ── Video generation (B-rolls, hooks) ──────────────────────────────
# Google Gemini + Veo 3 — direct hook clips via scripts/veo.py
GOOGLE_API_KEY=

# Higgsfield — Flux Pro Kontext, DoP, Veo 3, Kling, Seedance
# https://cloud.higgsfield.ai → API Management → issue a key pair
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=

# ── Audio ──────────────────────────────────────────────────────────
# ElevenLabs — music beds + SFX via scripts/eleven_{music,sfx}.py
ELEVENLABS_API_KEY=

# ── Delivery ───────────────────────────────────────────────────────
# Telegram bot — sends the finished MP4 to your chat.
# Create via @BotFather → /newbot, then paste the token here.
# scripts/telegram_agent.py registers the OWNER on first /start.
TELEGRAM_BOT_TOKEN=

# ── Optional ───────────────────────────────────────────────────────
# Obsidian Local REST API (only if you sync notes back into a vault)
# 1. Install the Local REST API community plugin in Obsidian.
# 2. Enable HTTPS, copy the generated API key.
# 3. Default listens on 127.0.0.1:27124.
OBSIDIAN_API_KEY=
OBSIDIAN_BASE_URL=https://127.0.0.1:27124

# Alternative B-roll generators (uncomment + fill if you use them)
# FAL_KEY=
# RUNWAY_API_KEY=
